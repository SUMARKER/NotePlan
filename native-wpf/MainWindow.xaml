<Window x:Class="NotePlanNative.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="NotePlan for Windows（原生预览版）"
        FontFamily="Segoe UI" FontSize="13"
        Width="1320" Height="860" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Menu DockPanel.Dock="Top" FontSize="13">
            <MenuItem Header="文件(_F)">
                <MenuItem Header="新建笔记  Ctrl+N" Click="Menu_NewNote" />
                <MenuItem Header="打开今日笔记  Ctrl+J" Click="Menu_OpenToday" />
                <Separator />
                <MenuItem Header="保存  Ctrl+S" Click="Menu_Save" />
                <MenuItem Header="退出" Click="Menu_Exit" />
            </MenuItem>
            <MenuItem Header="帮助(_H)">
                <MenuItem Header="原生预览版说明" Click="Menu_About" />
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom" Height="28">
            <TextBlock x:Name="SaveState" Text="就绪" />
            <TextBlock x:Name="WordCount" HorizontalAlignment="Right" />
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 侧栏 -->
            <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
                <Grid Margin="12,10,12,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0" x:Name="BtnNewNote" Content="＋ 新建笔记"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="BtnNewNote_Click" Height="32" Margin="0,0,0,8" />

                    <StackPanel Grid.Row="1" Margin="0,2,0,4">
                        <DockPanel>
                            <Button DockPanel.Dock="Left" x:Name="CalPrev" Content="‹" Width="26"
                                    Style="{StaticResource CalDayButtonStyle}" Click="CalPrev_Click" />
                            <Button DockPanel.Dock="Right" x:Name="CalNext" Content="›" Width="26"
                                    Style="{StaticResource CalDayButtonStyle}" Click="CalNext_Click" />
                            <TextBlock x:Name="CalTitle" FontWeight="Bold" TextAlignment="Center"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                        <UniformGrid x:Name="CalGrid" Columns="7" Margin="0,6,0,0" />
                    </StackPanel>

                    <TextBlock Grid.Row="2" Text="本月笔记" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}"
                               Margin="0,10,0,4" />
                    <ListBox Grid.Row="3" x:Name="DailyList" MaxHeight="130"
                             SelectionChanged="DailyList_SelectionChanged" />

                    <DockPanel Grid.Row="4" Margin="0,12,0,4">
                        <TextBlock Text="笔记" FontWeight="Bold" />
                        <TextBox x:Name="NoteFilter" DockPanel.Dock="Right" Width="96"
                                 TextChanged="NoteFilter_Changed" />
                    </DockPanel>
                    <ListBox Grid.Row="5" x:Name="NoteList"
                             SelectionChanged="NoteList_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2">
                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Sub}" Foreground="{StaticResource TextDimBrush}"
                                               FontSize="11" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Expander Grid.Row="6" x:Name="TrashExpander" Header="回收站" Margin="0,12,0,0"
                              FontWeight="Bold" Expanded="TrashExpander_Expanded">
                        <StackPanel>
                            <Button x:Name="BtnTrashEmpty" Content="清空回收站"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Click="BtnTrashEmpty_Click" Margin="0,4,0,6" />
                            <ListBox x:Name="TrashList">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="2,4,2,4">
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding OrigRel}" FontSize="11"
                                                       Foreground="{StaticResource TextDimBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <Button Content="恢复" Click="TrashRestore_Click" Margin="0,0,6,0"
                                                        Tag="{Binding}" />
                                                <Button Content="永久删除" Style="{StaticResource DangerButtonStyle}"
                                                        Click="TrashPurge_Click" Tag="{Binding}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="TrashEmptyHint" Text="回收站是空的"
                                       Foreground="{StaticResource TextDimBrush}" Margin="4,2,0,0" />
                        </StackPanel>
                    </Expander>

                    <Button Grid.Row="7" x:Name="BtnVaultFolder" Content="打开笔记库文件夹"
                            Click="BtnVaultFolder_Click" Margin="0,10,0,0" />
                </Grid>
            </Border>

            <!-- 编辑区 -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="14,10,14,4">
                    <Button DockPanel.Dock="Right" x:Name="BtnDeleteNote" Content="删除（进回收站）"
                            Click="BtnDeleteNote_Click" />
                    <TextBlock x:Name="NoteTitle" FontSize="15" FontWeight="Bold"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <avalonEdit:TextEditor Grid.Row="1" x:Name="Editor"
                                       FontFamily="Segoe UI" FontSize="15"
                                       WordWrap="True"
                                       Padding="18,10,18,20"
                                       HorizontalScrollBarVisibility="Hidden" />
            </Grid>
        </Grid>
    </DockPanel>
</Window>
