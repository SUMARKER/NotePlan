<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>NotePlanNative</RootNamespace>
    <AssemblyName>NotePlanNative</AssemblyName>
    <ApplicationIcon>assets\icon.ico</ApplicationIcon>
    <Version>0.1.0-preview</Version>
    <Product>NotePlan for Windows (Native Preview)</Product>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.0.90" />
  </ItemGroup>

  <!-- 数据层直接链接 WebView2 宿主的 C# 服务（单一数据源，两版共用同一份文件） -->
  <ItemGroup>
    <Compile Include="..\webview2\AppServices.cs" Link="AppServices.cs" />
    <Compile Include="..\webview2\IcsService.cs" Link="IcsService.cs" />
  </ItemGroup>

</Project>
