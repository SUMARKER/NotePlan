<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>NotePlanWpf</RootNamespace>
    <AssemblyName>NotePlan for Windows</AssemblyName>
    <ApplicationIcon>assets\icon.ico</ApplicationIcon>
    <InvariantGlobalization>false</InvariantGlobalization>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>0.3.0</Version>
    <Product>NotePlan for Windows</Product>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />
  </ItemGroup>

  <!-- 渲染层与资产（本目录内） -->
  <ItemGroup>
    <Content Include="src\**\*" Link="src\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="assets\icon.png" Link="assets\icon.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
