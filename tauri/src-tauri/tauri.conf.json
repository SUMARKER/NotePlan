{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NotePlan for Windows",
  "mainBinaryName": "NotePlan for Windows",
  "version": "0.5.3",
  "identifier": "com.noteplan.tauri",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "NotePlan for Windows",
        "width": 1320,
        "height": 860,
        "minWidth": 980,
        "minHeight": 620,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
